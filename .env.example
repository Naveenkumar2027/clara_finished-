# Groq API Configuration (get key from https://console.groq.com)
GROQ_API_KEY=

# Sarvam AI API Keys (get key from Sarvam AI)
SARVAM_API_KEY=
# STT language: unknown (auto-detect), en, hi, etc.
SARVAM_LANGUAGE_CODE=unknown
# Sarvam TTS voice configuration (Bulbul v3).
# Default: Simran (female, Indian accent) at slightly faster pace.
# Valid pace range is roughly 0.5–2.0; 1.0 = normal speed.
SARVAM_TTS_SPEAKER=simran
SARVAM_TTS_PACE=1.15
# Auto language detect from first transcript (supported: en/hi/kn/ta/te/ml)
AUTO_LANGUAGE_DETECT_ENABLED=true
AUTO_LANGUAGE_DETECT_CONFIDENCE_THRESHOLD=0.70
# Perf debug timings in WS payload + JSON turn logs
PERF_DEBUG_TIMINGS=true

# Hardware Configuration
CAMERA_INDEX=0
# Preferred mic selection keys (use one):
AUDIO_INPUT_DEVICE_INDEX=0
# AUDIO_INPUT_DEVICE_NAME=ReSpeaker
# Legacy key (deprecated): used only if AUDIO_INPUT_DEVICE_INDEX is unset.
MIC_DEVICE_INDEX=

# Paths
FACES_DB_PATH=config/faces.dat
UI_CONFIG_PATH=config/ui_config.json
TEMP_DIR=./temp

# PostgreSQL + pgvector (RAG storage). Required for college knowledge retrieval. Bind to localhost only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=clara_db
POSTGRES_USER=clara_user
# Required: set a strong password. Never commit .env.
POSTGRES_PASSWORD=

# RAG Configuration (college knowledge retrieval). RAG_MODEL must match a current Groq model id (see https://console.groq.com/docs/models); 404 usually means wrong or deprecated model.
RAG_MAX_TOKENS=6000
# Groq decommissioned llama-3.1-8b-instant (2026-08-16). Successor for answer generation:
RAG_MODEL=openai/gpt-oss-20b
MULTILINGUAL_PREPROCESSOR_MODEL=openai/gpt-oss-20b
COLLEGE_KNOWLEDGE_PATH=college_knowledge.txt
RAG_TOP_K=5

# M5.5 semantic router (proposal only). Separate from RAG_MODEL / answer generation.
SEMANTIC_ROUTER_ENABLED=true
SEMANTIC_ROUTER_MODEL=openai/gpt-oss-120b
SEMANTIC_ROUTER_TIMEOUT_S=6.0
RAG_MIN_DOCUMENTS=500

# State Machine Configuration
INACTIVITY_TIMEOUT=20.0

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SILENCE_STOP_MS=800
AUDIO_MAX_UTTERANCE_MS=9000

# LLM latency controls
LLM_MAX_TOKENS=100
LLM_TEMPERATURE=0.2
LLM_STREAM_PARTIAL_DEBOUNCE_MS=120
LLM_STREAM_TIMEOUT_S=8.0
RAG_CONTEXT_TIMEOUT_S=0.8
TTS_TIMEOUT_S=10.0
STT_TIMEOUT_S=8.0
# Kiosk TTS: hold THINKING until the first playable clip is validated, then present + play.
# Remaining clips may still generate. Set KIOSK_COMPLETE_RESPONSE_TTS=true to wait for every clip.
KIOSK_COMPLETE_RESPONSE_TTS=false
KIOSK_HOLD_THINKING_UNTIL_FIRST_AUDIO=true
TTS_SHORT_ANSWER_MAX_CHARS=480
TTS_CHUNK_MAX_ATTEMPTS=2
ENABLE_LLM_STREAMING=true
ENABLE_EARLY_PARTIAL_TEXT=true
LOW_LATENCY_VOICE_MODE=true
FIRST_SENTENCE_TTS_MAX_CHARS=160
AUDIO_UPDATE_TIMEOUT_S=3.0
TTS_CHUNK_FIRST_TIMEOUT_S=10.0
TTS_CHUNK_TIMEOUT_S=5.0
FULL_TTS_FALLBACK_TIMEOUT=20.0
ENABLE_FIRST_SENTENCE_TTS=true
ENABLE_TTS_PIPELINING=true
ENABLE_ONCE_ONLY_TTS_SEGMENTS=true

# Shared HTTP client tuning
HTTP_TIMEOUT_CONNECT_S=2.0
HTTP_TIMEOUT_READ_S=15.0
HTTP_TIMEOUT_WRITE_S=15.0
HTTP_TIMEOUT_POOL_S=2.0
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_MAX_CONNECTIONS=50
HTTP_KEEPALIVE_EXPIRY_S=30.0
HTTP_RETRY_ATTEMPTS=1

# Server Configuration
HOST=0.0.0.0
PORT=6969
FRONTEND_URL=http://localhost:5176
# Demo mode policy:
# - Default demo voice input is browser mode in frontend/.env.local:
#   VITE_VOICE_INPUT_MODE=browser
# - Backend mic mode remains available for kiosk/manual hardware verification.
# WebSocket handshake protection
# - Omit WS_AUTH_REQUIRED to auto-enable auth only when WS_AUTH_TOKEN or WS_TOKEN_SIGNING_SECRET is set.
# - Production: set WS_AUTH_REQUIRED=true and WS_TOKEN_SIGNING_SECRET. The browser
#   obtains a 90-second credential from POST /api/ws-token; no VITE_* secret is used.
WS_AUTH_REQUIRED=
# Development/test compatibility only. Strict production always rejects this token.
WS_AUTH_TOKEN=
# Required in strict production: HMAC-SHA256 signing secret for short-lived WS tokens.
WS_TOKEN_SIGNING_SECRET=
WS_TOKEN_TTL_SECONDS=90
WS_STATIC_TOKEN_ALLOWED=true
# Comma-separated allowed origins for WebSocket handshake Origin check.
WS_ALLOWED_ORIGINS=http://localhost:5176,http://127.0.0.1:5176

# Process-local token-bucket limits. Socket peer IP is used; forwarding headers are ignored.
WS_CONNECTION_MESSAGE_BURST=60
WS_CONNECTION_MESSAGE_RATE=1
WS_IP_MESSAGE_BURST=180
WS_IP_MESSAGE_RATE=3
WS_CONNECTION_EXPENSIVE_BURST=12
WS_CONNECTION_EXPENSIVE_RATE=0.2
WS_IP_EXPENSIVE_BURST=30
WS_IP_EXPENSIVE_RATE=0.5
WS_IP_CONNECT_BURST=20
WS_IP_CONNECT_RATE=0.333333
WS_RATE_LIMIT_MAX_IPS=5000
WS_RATE_LIMIT_STALE_SECONDS=600

# Strict production readiness gate. Keep false for local development.
PRODUCTION_STRICT_READY=false
REQUIRE_WS_AUTH_IN_PRODUCTION=true
