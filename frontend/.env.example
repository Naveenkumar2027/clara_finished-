# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLARA backend WebSocket (must match backend PORT, default 6969)
VITE_WS_URL=ws://localhost:6969/ws/clara
# Token attached as query param during ws handshake.
# WebSocket credentials are fetched from /api/ws-token and kept in memory only.
# Never place permanent credentials in a VITE_* variable.
# Demo default is pinned to browser mode for reliability.
# "browser" = Web Speech API capture in frontend, backend handles LLM/TTS.
# Requires internet: Chrome talks to Google’s cloud speech service (not CLARA :6969).
# Indic languages (kn/hi/ta/te/ml) are especially sensitive to that connectivity.
# "backend" = backend captures kiosk mic directly (manual hardware verification path).
VITE_VOICE_INPUT_MODE=browser
# Optional local debug ingest URL. Leave unset — hardcoded agent ports cause console noise.
# VITE_DEBUG_INGEST_URL=
# Milliseconds without user interaction (language pick, mic tap, typed/voice query) before hard reset → sleep.
# Optional; defaults to 60000 if unset or invalid.
# VITE_KIOSK_INACTIVITY_MS=60000
